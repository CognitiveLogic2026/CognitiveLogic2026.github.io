{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://cognitivelogic.it/schemas/international-watch/international-watch-source-registry.schema.json", "title": "IW isolated Source Registry", "type": "object", "allOf": [{"$ref": "common.schema.json"}],
  "required": ["source_id", "entity_id", "source_name", "jurisdiction", "source_role", "ownership_or_control", "primary_or_secondary", "party_to_event", "access_mode", "language", "publication_channel", "originator_of", "repeats", "derived_from", "known_method", "limitations", "identity_verification", "archived_capture", "content_hash", "publication_timestamp", "source_as_at", "accessed_at"],
  "properties": {
    "source_id": {"type": "string"}, "entity_id": {"type": ["string", "null"]}, "source_name": {"type": "string"}, "jurisdiction": {"type": "array", "items": {"type": "string"}}, "source_role": {"type": "array", "items": {"enum": ["originator", "publisher", "collector", "custodian", "analyst", "repeater", "translator", "aggregator"]}},
    "ownership_or_control": {"type": "object", "required": ["known", "description"], "properties": {"known": {"type": "boolean"}, "description": {"type": "string"}}, "additionalProperties": false}, "primary_or_secondary": {"enum": ["primary", "secondary", "mixed", "not_determined"]}, "party_to_event": {"enum": ["yes", "no", "unknown"]}, "access_mode": {"enum": ["open", "restricted", "licensed", "archived_only", "unavailable"]},
    "language": {"type": "array", "items": {"type": "string"}}, "publication_channel": {"type": "string"}, "originator_of": {"type": "array", "items": {"type": "string"}}, "repeats": {"type": "array", "items": {"type": "string"}}, "derived_from": {"type": "array", "items": {"type": "string"}}, "known_method": {"type": "string"}, "limitations": {"type": "array", "items": {"type": "string"}},
    "identity_verification": {"type": "object", "required": ["status", "basis"], "properties": {"status": {"enum": ["verified", "partially_verified", "unverified", "not_applicable"]}, "basis": {"type": "string"}}, "additionalProperties": false}, "archived_capture": {"type": ["string", "null"], "format": "uri"},
    "original_uri": {"type": ["string", "null"], "format": "uri"}, "archived_unavailability_reason": {"type": "string"}, "original_text_available": {"type": "boolean"}, "translation_trace": {"type": "array", "items": {"type": "string"}}, "publication_timestamp": {"type": ["string", "null"], "format": "date-time"}, "source_as_at": {"type": ["string", "null"], "format": "date-time"}, "accessed_at": {"type": "string", "format": "date-time"}
  }, "unevaluatedProperties": false
}
