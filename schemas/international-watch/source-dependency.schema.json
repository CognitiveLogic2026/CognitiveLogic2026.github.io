{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://cognitivelogic.it/schemas/international-watch/source-dependency.schema.json", "title": "IW Source Dependency Graph Edge", "type": "object",
  "required": ["node_id", "node_type", "edge_id", "edge_type", "from", "to", "shared_origin_id", "evidence_collection_independent", "organizationally_independent", "ownership_independent", "methodologically_independent", "shared_dataset", "shared_agency", "shared_statement", "republication_or_translation", "dependency_basis", "dependency_status", "unknown_dependency", "counts_as_independent_corroboration"],
  "properties": {
    "node_id": {"type": "string"}, "node_type": {"enum": ["source", "document", "statement", "dataset", "evidence", "agency"]}, "edge_id": {"type": "string"}, "edge_type": {"enum": ["originates", "repeats", "republication", "translation", "summary", "derived_from", "uses_dataset", "uses_agency", "uses_statement", "uses_evidence", "possible_dependency", "independent_collection"]}, "from": {"type": "string"}, "to": {"type": "string"}, "shared_origin_id": {"type": ["string", "null"]},
    "evidence_collection_independent": {"enum": ["yes", "no", "unknown"]}, "organizationally_independent": {"enum": ["yes", "no", "unknown"]}, "ownership_independent": {"enum": ["yes", "no", "unknown"]}, "methodologically_independent": {"enum": ["yes", "no", "unknown"]}, "shared_dataset": {"enum": ["yes", "no", "unknown"]}, "shared_agency": {"enum": ["yes", "no", "unknown"]}, "shared_statement": {"enum": ["yes", "no", "unknown"]}, "republication_or_translation": {"type": "boolean"}, "dependency_basis": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "dependency_status": {"enum": ["dependent", "independent", "partially_dependent", "not_determined"]}, "unknown_dependency": {"type": "boolean"}, "counts_as_independent_corroboration": {"type": "boolean"}
  },
  "allOf": [
    {"$ref": "common.schema.json"},
    {"if": {"anyOf": [{"properties": {"republication_or_translation": {"const": true}}, "required": ["republication_or_translation"]}, {"properties": {"unknown_dependency": {"const": true}}, "required": ["unknown_dependency"]}, {"properties": {"evidence_collection_independent": {"enum": ["no", "unknown"]}}, "required": ["evidence_collection_independent"]}]}, "then": {"properties": {"counts_as_independent_corroboration": {"const": false}}}}
  ], "unevaluatedProperties": false
}
