{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://cognitivelogic.it/schemas/international-watch/claim-registry.schema.json", "title": "IW Claim Registry", "type": "object", "allOf": [{"$ref": "common.schema.json"}],
  "required": ["claim_id", "event_id", "claim_text_original", "language", "translation", "translation_method", "claim_type", "speaker_actor_id", "origin_source_id", "origin_timestamp", "publication_timestamp", "original_context", "subject", "predicate", "object", "qualifiers", "geographic_scope", "temporal_scope", "definition_refs", "testability", "evidence_refs", "counter_evidence_refs", "counter_evidence_absence_reason", "dependency_refs", "assessment_id", "revision_triggers"],
  "properties": {
    "claim_id": {"type": "string"}, "event_id": {"type": "string"}, "claim_text_original": {"type": "string", "minLength": 1}, "language": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"},
    "translation": {"type": ["string", "null"]}, "translation_method": {"enum": ["none", "human", "machine_reviewed", "machine_unreviewed"]}, "claim_type": {"enum": ["observable_fact", "statement", "inference", "interpretation"]},
    "speaker_actor_id": {"type": ["string", "null"]}, "origin_source_id": {"type": "string", "minLength": 1}, "origin_timestamp": {"type": ["string", "null"], "format": "date-time"}, "publication_timestamp": {"type": ["string", "null"], "format": "date-time"}, "original_context": {"type": "string"},
    "subject": {"type": "string", "minLength": 1}, "predicate": {"type": "string", "minLength": 1}, "object": {"type": "string", "minLength": 1},
    "qualifiers": {"type": "array", "items": {"type": "string"}}, "geographic_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "temporal_scope": {"type": "object", "required": ["start", "end"], "properties": {"start": {"type": ["string", "null"], "format": "date-time"}, "end": {"type": ["string", "null"], "format": "date-time"}}, "additionalProperties": false},
    "definition_refs": {"type": "array", "items": {"type": "string"}}, "testability": {"type": "object", "required": ["status", "method"], "properties": {"status": {"enum": ["testable", "partially_testable", "not_testable"]}, "method": {"type": "string"}}, "additionalProperties": false},
    "evidence_refs": {"type": "array", "items": {"type": "string"}}, "counter_evidence_refs": {"type": "array", "items": {"type": "string"}}, "counter_evidence_absence_reason": {"type": ["string", "null"]}, "dependency_refs": {"type": "array", "items": {"type": "string"}}, "assessment_id": {"type": ["string", "null"]}, "revision_triggers": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }, "unevaluatedProperties": false
}
