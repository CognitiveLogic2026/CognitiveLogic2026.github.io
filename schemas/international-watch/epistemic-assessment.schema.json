{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://cognitivelogic.it/schemas/international-watch/epistemic-assessment.schema.json", "title": "IW Epistemic Assessment", "type": "object", "allOf": [{"$ref": "common.schema.json"}],
  "required": ["assessment_id", "claim_id", "state", "state_definition_version", "reasoning_summary", "supporting_evidence", "contrary_evidence", "independent_evidence_groups", "unresolved_contradictions", "scope", "as_of", "unknowns", "limits", "decision_rules_applied", "excluded_evidence", "reviewer", "review_due", "previous_assessment", "change_reason"],
  "properties": {
    "assessment_id": {"type": "string"}, "claim_id": {"type": "string"}, "state": {"enum": ["ACCERTATO", "FORTEMENTE_CORROBORATO", "PLAUSIBILE", "CONTESTATO", "NON_VERIFICATO", "CONTRADDETTO", "INDETERMINABILE"]}, "state_definition_version": {"type": "string"}, "reasoning_summary": {"type": "string", "minLength": 1}, "supporting_evidence": {"type": "array", "items": {"type": "string"}}, "contrary_evidence": {"type": "array", "items": {"type": "string"}},
    "independent_evidence_groups": {"type": "array", "items": {"type": "object", "required": ["group_id", "evidence_ids", "independence_basis"], "properties": {"group_id": {"type": "string"}, "evidence_ids": {"type": "array", "items": {"type": "string"}}, "independence_basis": {"type": "string"}}, "additionalProperties": false}}, "unresolved_contradictions": {"type": "array", "items": {"type": "string"}},
    "scope": {"type": "object", "required": ["geographic", "temporal", "definitions"], "properties": {"geographic": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "temporal": {"type": "object", "required": ["start", "end"], "properties": {"start": {"type": ["string", "null"], "format": "date-time"}, "end": {"type": ["string", "null"], "format": "date-time"}}, "additionalProperties": false}, "definitions": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "unknowns": {"type": "array", "items": {"type": "string"}}, "limits": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "decision_rules_applied": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "excluded_evidence": {"type": "array", "items": {"type": "object", "required": ["evidence_id", "reason"], "properties": {"evidence_id": {"type": "string"}, "reason": {"type": "string"}}, "additionalProperties": false}}, "reviewer": {"type": "string", "minLength": 1}, "previous_assessment": {"type": ["string", "null"]}, "change_reason": {"type": "string"}
  }, "unevaluatedProperties": false
}
